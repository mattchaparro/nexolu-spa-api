APP_NAME="Nexolu Spa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

# El timezone de la app es UTC a proposito: la zona horaria real es una
# propiedad de cada negocio (businesses.timezone), no una constante global.
# Blue Souls tenia America/Bogota incrustado en 16 archivos.
APP_TIMEZONE=UTC

# La sesion de MySQL TIENE que estar en la misma zona que APP_TIMEZONE.
# config/database.php trae -05:00 por defecto (pensado para cuando la app
# corria en America/Bogota): con APP_TIMEZONE=UTC, MySQL toma cada hora UTC
# como si fuera de Bogota y la guarda en las columnas TIMESTAMP (created_at,
# updated_at) corrida +5h. La app lo deshace al leer, asi que para ella
# todo cuadra, pero cualquiera que lea la base directo ve horas falsas (un
# mensaje de las 7:24 am en Bogota aparece a las 17:24 "UTC").
# En produccion sigue en -05:00 a proposito hasta la re-migracion desde
# Legacy: cambiarlo con datos vivos deja los mensajes ya guardados 5h en el
# futuro. AL BORRAR LA BD PARA RE-MIGRAR: poner +00:00.
DB_TIMEZONE=+00:00

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexolu_spa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Front autorizado ---
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# --- Nexolu Communications ---
# Unico canal de WhatsApp y correo. Este producto nace del lado correcto: no
# hay driver alterno contra Meta directo.
COMMS_CORE_BASE_URL=http://localhost:8010
COMMS_CORE_API_KEY=
COMMS_CORE_WEBHOOK_SECRET=
# La que un flujo de Connect manda como Bearer en su "Solicitud externa"
# (GET /api/connect/disponibilidad). Distinta de la api_key a proposito.
COMMS_CORE_TOOLS_KEY=

# --- Nexolu IA Core ---
# Credencial simetrica en los dos sentidos.
IA_CORE_BASE_URL=http://localhost:8000
IA_CORE_API_KEY=
IA_CORE_APP_ID=spa

# Teléfono con el que `ia:evaluar` conversa con el bot. Pon el tuyo: si
# algún mensaje de la evaluación se escapa, que te llegue a ti y no a una
# clienta. Aun así no salen, salvo que corras `ia:evaluar --enviar`.
# Sin esto se usa un +999…, que no es de nadie.
IA_EVAL_PHONE=

# --- Nexolu Payments Core ---
PAYMENTS_CORE_BASE_URL=http://localhost:8020
PAYMENTS_CORE_API_KEY=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- DigitalOcean Spaces (imagenes) ---
# Sin SPACES_KEY, ImageStorage cae al disco publico del proyecto: en local no
# hace falta cuenta de nube. En produccion es obligatorio -- el droplet no
# tiene backups y una recreacion se llevaria todas las fotos.
FILESYSTEM_DISK=public
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_CDN_URL=

# Pagina publica de reservas, sin barra final. El bot manda este enlace a
# quien prefiere agendar sola.
PUBLIC_BOOKING_URL=https://agenda.nexolu.co
